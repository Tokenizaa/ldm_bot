# ============================================
# ForgeDeals — Painel Operacional Configurável
# Copie para .env e preencha com valores reais:
#   cp .env.example .env
# Variáveis obrigatórias (backend/workers):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#   LOJA_DO_MECANICO_EMAIL, LOJA_DO_MECANICO_PASSWORD
# ============================================

# Supabase — backend usa SERVICE ROLE, não anon key
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Redis (obrigatório para workers)
REDIS_URL="redis://localhost:6379"

# Credenciais do crawler Loja do Mecânico
LOJA_DO_MECANICO_EMAIL="your-email@example.com"
LOJA_DO_MECANICO_PASSWORD="your-password"

# Ollama (API e workers)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3:8b"

# Chrome CDP (publisher Facebook / crawler)
CDP_PORT="9222"
CDP_URL="http://localhost:9222"
CHROME_USER_DATA_DIR="C:\\Users\\YOU\\AppData\\Local\\Google\\Chrome\\User Data"
CHROME_PROFILE_DIRECTORY="Profile 1"

# Web (Vite dev server + proxy /api)
VITE_API_URL="http://localhost:3001"

# Workers
NODE_ENV="development"
RUN_LDM_CRAWLER="false"

# API
API_PORT="3001"
API_HOST="0.0.0.0"

# Legado — web antiga usa anon key; root vite.config define GEMINI_API_KEY
SUPABASE_ANON_KEY="your-anon-key"
GEMINI_API_KEY=""