{
  "name": "forge-deals-bot",
  "version": "1.0.0",
  "description": "Bot simples para extração de produtos da Loja do Mecânico e postagem no Facebook",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --exec ts-node src/index.ts",
    "dev:frontend": "vite",
    "build": "tsc",
    "build:frontend": "vite build",
    "test": "ts-node tests/run-tests.ts"
  },
  "keywords": [
    "bot",
    "crawler",
    "facebook",
    "automation",
    "loja-do-mecanico"
  ],
  "author": "ForgeDeals",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.8.3"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  }
}
