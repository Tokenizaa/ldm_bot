{
  "name": "forge-deals",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:workers": "npm --workspace apps/workers run dev",
    "chrome:legacy": "node start-chrome-CDP.js",
    "chrome:setup": "node scripts/setup-and-start.js setup",
    "chrome:start": "node scripts/setup-and-start.js start",
    "chrome:open": "node scripts/open-pages.js",
    "chrome:test": "npx tsx tests/test-cdp-connection.ts",
    "browser:connect": "npx tsx scripts/connect-browser.ts",
    "test": "npx tsx tests/run-tests.ts",
    "test:cdp": "npx tsx tests/test-cdp-connection.ts",
    "test:fb": "npx tsx tests/run-tests.ts 2",
    "typecheck": "npm -ws run typecheck",
    "lint": "npm -ws run lint",
    "build": "npm -ws run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
