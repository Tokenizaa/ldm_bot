{
  "name": "forge-deals-bot",
  "version": "1.0.0",
  "description": "Bot simples para extração de produtos da Loja do Mecânico e postagem no Facebook",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "chrome:start": "node start-chrome-CDP.js",
    "test": "ts-node tests/run-tests.ts",
    "test:cdp": "ts-node tests/run-tests.ts 1"
  },
  "keywords": ["bot", "crawler", "facebook", "automation", "loja-do-mecanico"],
  "author": "ForgeDeals",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.40.0",
    "@supabase/supabase-js": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "ts-node": "^10.9.0",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
