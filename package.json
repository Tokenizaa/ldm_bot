{
  "name": "forge-deals-bot",
  "version": "1.0.0",
  "description": "ForgeDeals - Painel Operacional Configurável para Automação Social",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"wait-on http://localhost:3001/health && npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@forge-deals/api",
    "dev:web": "npm run dev --workspace=@forge-deals/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=@forge-deals/api",
    "build:web": "npm run build --workspace=@forge-deals/web",
    "chrome:legacy": "node scripts/setup-and-start.js",
    "chrome:setup": "node scripts/setup-and-start.js",
    "test:cdp": "ts-node tests/test-cdp-connection.ts"
  },
  "keywords": [
    "bot",
    "crawler",
    "facebook",
    "automation",
    "loja-do-mecanico",
    "operational-panel"
  ],
  "author": "ForgeDeals",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.63.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
