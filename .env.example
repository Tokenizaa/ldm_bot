# ============================================
# LDM Bot — configuração local
# Copie para .env e preencha com valores reais.
# ============================================

# Supabase — backend usa SERVICE ROLE, nunca exponha ao frontend
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Credenciais do crawler Loja do Mecânico
LOJA_DO_MECANICO_EMAIL="your-email@example.com"
LOJA_DO_MECANICO_PASSWORD="your-password"

# NVIDIA NIM — geração de copy da Fase 3
NVIDIA_API_KEY="your-nvidia-api-key"
NVIDIA_MODEL="meta/llama-4-maverick-17b-128e-instruct"

# Chrome CDP (publisher Facebook / crawler)
CDP_PORT="9222"
CDP_URL="http://localhost:9222"
CHROME_USER_DATA_DIR="C:\\Users\\YOU\\AppData\\Local\\Google\\Chrome\\User Data"
CHROME_PROFILE_DIRECTORY="Profile 1"

# Web (Vite dev server + proxy /api)
VITE_API_URL="http://localhost:3001"

# Runtime API
NODE_ENV="development"
API_PORT="3001"
API_HOST="0.0.0.0"
