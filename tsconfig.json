{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/browser.ts",
    "src/crawler.ts",
    "src/database.ts",
    "src/facebook.ts",
    "src/index.ts",
    "src/ollama.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/App.tsx",
    "src/main.tsx",
    "src/pages",
    "src/scripts",
    "src/services",
    "src/utils",
    "src/types.ts"
  ]
}
